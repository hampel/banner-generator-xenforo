includes:
    - vendor/hampel/xenforo-phpstan/extension.neon

parameters:
    level: max

    paths:
        - .

    excludePaths:
        # Scanned through the Composer autoloader already; scanning the directory as well lets a
        # dependency's scaffold shadow the add-on's own classes of the same name.
        analyseAndScan:
            - vendor (?)
        # Generated by XenForo, and not the add-on's code.
        analyse:
            - _output (?)
            - _releases (?)
            - _data (?)

    # types this add-on's own three options, and still reports a mistyped name
    stubFiles:
        - _output/option_hint.php

    # the add-on's sub-container, registered in Listener::appSetup() through extendClass(), so an
    # extension of it is still this class
    xenforo:
        container:
            banner: Hampel\BannerGenerator\SubContainer\Banner
